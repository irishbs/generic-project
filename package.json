{
  "name": "generic-project",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright and SDET practice: a small full-stack app with unit, integration, API, UI, security, and performance tests.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --project unit",
    "test:unit:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui --project=ui-firefox --project=ui-webkit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit && npm run test:integration && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.65.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.13.0",
    "globals": "^15.15.0",
    "prettier": "^3.3.3",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.10.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "jose": "^6.2.17",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
